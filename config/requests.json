{
  "clickToCall": {
    "schema": {
      "method": "POST",
      "host": "<%= iparam.call_action_host %>",
      "path": "<%= iparam.call_action_path %>",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <%= iparam.tenant_token %>"
      }
    }
  },
  "getWsToken": {
    "schema": {
      "method": "POST",
      "host": "<%= iparam.ws_issuer_host %>",
      "path": "<%= iparam.ws_issuer_path %>",
      "headers": {
        "Content-Type": "application/json",
        "X-API-Key": "<%= iparam.tenant_token %>"
      }
    }
  }
}